# better-auth declares OPTIONAL peer deps for every framework it can integrate
# with, including @sveltejs/kit. npm 7+ tries to satisfy that whole optional
# tree, and @sveltejs/vite-plugin-svelte peers on vite@8 while our vitest uses
# vite@7 — an ERESOLVE conflict over a Svelte adapter this Next.js project will
# never load.
#
# legacy-peer-deps makes npm install peers the pre-7 way (warn, don't block).
# Committed so a fresh clone and CI install identically rather than tripping on
# the same phantom conflict.
legacy-peer-deps=true
