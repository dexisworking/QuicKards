# ============================================
# QuicKards v2 — environment
# ============================================
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
# See docs/SETUP.md for where each value comes from.
#
# Phase 2 needs only the Database + Auth blocks. The rest arrive with their
# phases; leaving them blank is fine until then.

# ── Database (Neon) ─────────────────────────────────────────────────────────
# Pooled connection string — the host contains "-pooler".
DATABASE_URL=

# ── Auth (Better Auth) ──────────────────────────────────────────────────────
# 32+ random bytes: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Blob storage (Cloudflare R2) — Phase 3 ──────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=quickards
# The Cloudflare API token value (cfat_…). NOT used by the S3 code path — kept
# only for bucket-admin ops (e.g. CORS) via the Cloudflare REST API. Optional.
R2_API_TOKEN=
# Optional: custom domain for public gallery thumbnails (Phase 9)
R2_PUBLIC_BASE_URL=

# ── Render queue (Inngest) — Phase 5 ────────────────────────────────────────
# Local dev uses `npx inngest-cli dev` and needs neither of these.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Billing (Razorpay) — Phase 8 ────────────────────────────────────────────
# Dashboard → Settings → API Keys → Generate Test Key. Test mode needs no KYC.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same value as RAZORPAY_KEY_ID — exposed to the browser Checkout widget.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Created when you add a webhook endpoint (Settings → Webhooks) — Phase 8.
RAZORPAY_WEBHOOK_SECRET=
